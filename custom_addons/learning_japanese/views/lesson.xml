<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lesson_action" model="ir.actions.act_window">
            <field name="name">Lesson</field>
            <field name="res_model">learning_japanese.lesson</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Add a new lesson
               </p>
            </field>
        </record>

        <record id="view_lesson_list" model="ir.ui.view">
            <field name="name">learning_japanese.lesson.list</field>
            <field name="model">learning_japanese.lesson</field>
            <field name="arch" type="xml">
                <list multi_edit="1" export_xlsx="1" string="Lesson List View">
                    <field name="lesson"/>
                    <field name="book_id"/>
                </list>
            </field>
        </record>

        <record id="view_lesson_form" model="ir.ui.view">
            <field name="name">learning_japanese.lesson.form</field>
            <field name="model">learning_japanese.lesson</field>
            <field name="arch" type="xml">
                <form string="Lesson Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="lesson"/>
                                <field name="book_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Từ vựng">
                                <field name="vocabulary_ids">
                                    <list string="Vocabulary">
                                        <field name="vocabulary"/>
                                        <field name="higarana" optional="show"/>
                                        <field name="vietnamese" optional="show"/>
                                        <field name="level" optional="hide"/>
                                    </list>
                                </field>
                            </page>

                           <page string="Grammar">
                                <field name="grammar_ids"
                                       context="{'default_tag_name': 'Grammar'}">
                                    <list>
                                        <field name="title"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Reading">
                                <field name="reading_ids"
                                       context="{'default_tag_name': 'Reading'}">
                                    <list>
                                        <field name="title"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Listening">
                                <field name="listening_ids"
                                       context="{'default_tag_name': 'Listening'}">
                                    <list>
                                        <field name="title"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Writing">
                                <field name="writing_ids"
                                       context="{'default_tag_name': 'Writing'}">
                                    <list>
                                        <field name="title"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>