<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="llm_config_action" model="ir.actions.act_window">
            <field name="name">LLM Config</field>
            <field name="res_model">learning_japanese.llm_config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Create LLM config
               </p>
            </field>
        </record>

        <record id="view_llm_config_list" model="ir.ui.view">
            <field name="name">learning_japanese.llm_config.list</field>
            <field name="model">learning_japanese.llm_config</field>
            <field name="arch" type="xml">
                <list string="LLM Configurations" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="provider"/>
                    <field name="model_code"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_llm_config_form" model="ir.ui.view">
            <field name="name">learning_japanese.llm_config.form</field>
            <field name="model">learning_japanese.llm_config</field>
            <field name="arch" type="xml">
                <form string="LLM Config Form View">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" default_focus="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="model_code"/>
                                <field name="provider"/>
                                <field name="is_active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>