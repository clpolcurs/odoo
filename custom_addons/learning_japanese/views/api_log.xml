<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_audit_log_list" model="ir.ui.view">
            <field name="name">learning_japanese.audit_log.list</field>
            <field name="model">learning_japanese.audit_log</field>
            <field name="arch" type="xml">
                <list string="Nhật ký ghi qua API" create="0" edit="0" delete="0">
                    <field name="create_date" string="Lúc"/>
                    <field name="user_id"/>
                    <field name="op"/>
                    <field name="entity"/>
                    <field name="res_id"/>
                </list>
            </field>
        </record>

        <record id="view_audit_log_form" model="ir.ui.view">
            <field name="name">learning_japanese.audit_log.form</field>
            <field name="model">learning_japanese.audit_log</field>
            <field name="arch" type="xml">
                <form string="Nhật ký ghi qua API" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="create_date" string="Lúc"/>
                                <field name="user_id"/>
                                <field name="op"/>
                            </group>
                            <group>
                                <field name="entity"/>
                                <field name="res_id"/>
                            </group>
                        </group>
                        <group string="Trước">
                            <field name="before" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Sau">
                            <field name="after" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_audit_log_search" model="ir.ui.view">
            <field name="name">learning_japanese.audit_log.search</field>
            <field name="model">learning_japanese.audit_log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="entity"/>
                    <field name="res_id"/>
                    <field name="user_id"/>
                    <filter name="group_entity" string="Loại" context="{'group_by': 'entity'}"/>
                </search>
            </field>
        </record>

        <record id="audit_log_action" model="ir.actions.act_window">
            <field name="name">Nhật ký ghi qua API</field>
            <field name="res_model">learning_japanese.audit_log</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_change_log_list" model="ir.ui.view">
            <field name="name">learning_japanese.change_log.list</field>
            <field name="model">learning_japanese.change_log</field>
            <field name="arch" type="xml">
                <list string="Sự kiện đồng bộ" create="0" edit="0" delete="0">
                    <field name="id" string="Seq"/>
                    <field name="at"/>
                    <field name="op"/>
                    <field name="entity"/>
                    <field name="res_id"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>

        <record id="change_log_action" model="ir.actions.act_window">
            <field name="name">Sự kiện đồng bộ</field>
            <field name="res_model">learning_japanese.change_log</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>
