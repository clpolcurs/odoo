<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="comprehensive_tag_action" model="ir.actions.act_window">
            <field name="name">Comprehensive Topic</field>
            <field name="res_model">learning_japanese.comprehensive_tag</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Create new comprehensive topic
               </p>
            </field>
        </record>

        <record id="view_comprehensive_tag_list" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive_tag.list</field>
            <field name="model">learning_japanese.comprehensive_tag</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="Tags List">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>
    </data>
</odoo>