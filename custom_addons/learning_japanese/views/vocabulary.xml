<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_vocabulary_search" model="ir.ui.view">
            <field name="name">learning_japanese.vocabulary.search</field>
            <field name="model">learning_japanese.vocabulary</field>
            <field name="arch" type="xml">
                <search string="Vocabulary">
                    <field name="vietnamese" string="Nghĩa" filter_domain="[('vietnamese', 'ilike', self)]"/>
                    <field name="vocabulary" string="Vocabulary/Higarana" filter_domain="['|', '|', '|', '|','|','|','|','|','|','|','|','|','|', ('vocabulary', 'ilike', self), ('higarana', 'ilike', self), ('the_tu_dien', 'ilike', self), ('the_qua_khu', 'ilike', self), ('the_phu_dinh', 'ilike', self), ('the_te', 'ilike', self), ('the_kha_nang', 'ilike', self), ('the_thu_dong', 'ilike', self), ('the_sai_khien', 'ilike', self), ('the_sai_khien_thu_dong', 'ilike', self), ('the_dieu_kien', 'ilike', self), ('the_menh_lenh', 'ilike', self), ('the_y_chi', 'ilike', self), ('the_cam_chi', 'ilike', self)]"/>
                    <field name="katakana" string="Katakana" filter_domain="[('katakana', 'ilike', self)]"/>
                    <field name="romanji" string="Romanji" filter_domain="[('romanji', 'ilike', self)]"/>
                    <field name="han_viet" string="Hán Việt" filter_domain="[('han_viet', 'ilike', self)]"/>
                    <field name="content" string="content_only_kanji" filter_domain="[('content_only_kanji', 'ilike', self)]"/>
                    <searchpanel>
                        <field name="part_of_speech_id" string="Part of speach" icon="fa-filter" enable_counters="1"/>
                        <field name="context_tag_id" string="Topic" icon="fa-filter" enable_counters="1"/>
                    </searchpanel>
                </search>
             </field>
        </record>

        <record id="vocabulary_action" model="ir.actions.act_window">
            <field name="name">Từ vựng</field>
            <field name="res_model">learning_japanese.vocabulary</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_vocabulary_search"/>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Tạo mới từ vựng
               </p>
            </field>
        </record>

        <record id="view_vocabulary_list" model="ir.ui.view">
            <field name="name">learning_japanese.vocabulary.list</field>
            <field name="model">learning_japanese.vocabulary</field>
            <field name="arch" type="xml">
                <list multi_edit="1" export_xlsx="1" string="Vocabulary List View">
                    <field name="vocabulary" decoration-bf="1"/>
                    <field name="higarana" optional="show"/>
                    <field name="katakana" optional="show"/>
                    <field name="romanji" optional="hide"/>
                    <field name="part_of_speech_id" optional="hide"/>
                    <field name="han_viet" optional="hide"/>
                    <field name="vietnamese" optional="show"/>
                    <field name="book_ids" widget="many2many_tags" optional="hide"/>
                    <field name="lesson_ids" widget="many2many_tags" optional="hide"/>
                    <field name="level" optional="hide"/>
                    <field name="context_tag_id" optional="hide"/>
                    <field name="nhom_dong_tu" optional="hide"/>
                    <field name="is_intransitive" optional="hide"/>
                    <field name="nhom_ngu" optional="hide"/>
                    <field name="content_only_kanji" optional="show"/>
                    <field name="the_tu_dien" optional="hide"/>
                    <field name="the_te" optional="hide"/>
                    <field name="the_qua_khu" optional="hide"/>
                    <field name="the_phu_dinh" optional="hide"/>
                    <field name="the_kha_nang" optional="hide"/>
                    <field name="the_y_chi" optional="hide"/>
                    <field name="the_sai_khien" optional="hide"/>
                    <field name="the_sai_khien_thu_dong" optional="hide"/>
                    <field name="the_dieu_kien" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_vocabulary_form" model="ir.ui.view">
            <field name="name">learning_japanese.vocabulary.form</field>
            <field name="model">learning_japanese.vocabulary</field>
            <field name="arch" type="xml">
                <form string="Vocabulary Form View">
                    <header>
                        <button name="action_reverse" string="Reverse" type="object" invisible="is_finalized == False"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="vocabulary"/>
                            <h1><field name="vocabulary" default_focus="1"/></h1>
                        </div>
                        <br/>
                        <group>
                            <group>
                                <field name="higarana"/>
                                <field name="katakana"/>
                                <field name="romanji"/>
                                <field name="part_of_speech_id"/>
                                <field name="nhom_dong_tu" invisible="part_of_speech_id != 2"/>
                                <field name="nhom_ngu"/>
                                <field name="is_intransitive" invisible="part_of_speech_id != 2"/>
                                <field name="is_finalized" invisible="1"/>
                            </group>
                            <group>
                                <field name="lesson_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="book_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="level"/>
                                <field name="han_viet"/>
                                <field name="vietnamese" placeholder="Auto generate by OpenAI"/>
                                <field name="context_tag_id" context="{'show_complete_name': True}"/>
                            </group>
                        </group>

                        <group string="Thể động từ" invisible="part_of_speech_id != 2"/>
                        <group>
                            <group>
                                <field name="the_tu_dien" invisible="part_of_speech_id != 2"/>
                                <field name="the_te" invisible="part_of_speech_id != 2"/>
                                <field name="the_qua_khu" invisible="part_of_speech_id != 2"/>
                                <field name="the_phu_dinh" invisible="part_of_speech_id != 2"/>
                                <field name="the_kha_nang" invisible="part_of_speech_id != 2"/>
                                <field name="the_y_chi" invisible="part_of_speech_id != 2"/>
                            </group>
                             <group>
                                <field name="the_menh_lenh" invisible="part_of_speech_id != 2"/>
                                <field name="the_cam_chi" invisible="part_of_speech_id != 2"/>
                                <field name="the_thu_dong" invisible="part_of_speech_id != 2"/>
                                <field name="the_sai_khien" invisible="part_of_speech_id != 2"/>
                                <field name="the_sai_khien_thu_dong" invisible="part_of_speech_id != 2"/>
                                <field name="the_dieu_kien" invisible="part_of_speech_id != 2"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Ví dụ">
                                <field class="html_field_font_size" name="content_only_kanji" placeholder="Auto generate by OpenAI, and follow format &lt;&lt;kanji&gt;&gt; ... "/>
                            </page>

                             <page string="Chú thích Kanji">
                                <field class="html_field_font_size" name="content"/>
                            </page>
                       </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>