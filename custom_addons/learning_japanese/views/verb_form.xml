<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="verb_form_action" model="ir.actions.act_window">
            <field name="name">Thể động từ</field>
            <field name="res_model">learning_japanese.verb_form</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Tạo mới thể động từ
               </p>
            </field>
        </record>

        <record id="view_verb_form_tree" model="ir.ui.view">
            <field name="name">learning_japanese.verb_form.tree</field>
            <field name="model">learning_japanese.verb_form</field>
            <field name="arch" type="xml">
                <tree string="Verb Form Tree View">
                    <field name="sequence" widget="handle"/>
                    <field name="verb_form"/>
                    <field name="description" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_verb_form_form" model="ir.ui.view">
            <field name="name">learning_japanese.verb_form.form</field>
            <field name="model">learning_japanese.verb_form</field>
            <field name="arch" type="xml">
                <form string="Verb Form Form View">
                    <sheet>
                         <div class="oe_title">
                            <label for="verb_form"/>
                            <h1><field name="verb_form" default_focus="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Chi tiết">
                                <tree>
                                    <field class="html_field_font_size" name="detail" placeholder="Follow format &lt;&lt;kanji&gt;&gt; ..."/>
                                </tree>
                            </page>

                            <page string="Ngữ pháp liên quan">
                                <tree>
                                    <field name="grammar_ids"/>
                                </tree>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>