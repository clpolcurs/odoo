<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="verb_group_action" model="ir.actions.act_window">
            <field name="name">Nhóm động từ</field>
            <field name="res_model">learning_japanese.verb_group</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Tạo mới nhóm động từ
               </p>
            </field>
        </record>

        <record id="view_verb_group_tree" model="ir.ui.view">
            <field name="name">learning_japanese.verb_group.tree</field>
            <field name="model">learning_japanese.verb_group</field>
            <field name="arch" type="xml">
                <tree string="Verb Group Tree View">
                    <field name="verb_group"/>
                    <field name="description" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_verb_group_form" model="ir.ui.view">
            <field name="name">learning_japanese.verb_group.form</field>
            <field name="model">learning_japanese.verb_group</field>
            <field name="arch" type="xml">
                <form string="Verb Group Form View">
                    <sheet>
                         <div class="oe_title">
                            <label for="verb_group"/>
                            <h1><field name="verb_group" default_focus="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                        <group string="Chi tiết"/>
                        <field name="detail" placeholder="Follow format &lt;&lt;kanji&gt;&gt; ..."/>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>