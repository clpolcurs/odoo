<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="openai_support_action" model="ir.actions.act_window">
            <field name="name">AI Support</field>
            <field name="res_model">learning_japanese.openai_support</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Create new AI support request
               </p>
            </field>
        </record>

        <record id="view_openai_support_list" model="ir.ui.view">
            <field name="name">learning_japanese.openai_support.list</field>
            <field name="model">learning_japanese.openai_support</field>
            <field name="arch" type="xml">
                <list export_xlsx="1" multi_edit="1" string="OpenAI Support List View">
                    <field name="request_name" optional="show"/>
                    <field name="content" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_openai_support_form" model="ir.ui.view">
            <field name="name">learning_japanese.openai_support.form</field>
            <field name="model">learning_japanese.openai_support</field>
            <field name="arch" type="xml">
                <form string="AI Support Form View">
                    <sheet>
                        <div class="oe_title">
                            <label for="request_name"/>
                            <h1><field name="request_name" default_focus="1"/></h1>
                        </div>
                        <br/>
                        <group>
                            <group>
                                <field name="prompt_request_id"/>
                                <field name="llm_id"/>
                                <field name="is_send_request"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Request Content">
                                <field class="html_field_font_size" name="content"/>
                            </page>
                            <page string="Response">
                                <field class="html_field_font_size" name="response"/>
                            </page>
                       </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>