<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="comprehensive_action" model="ir.actions.act_window">
            <field name="name">Comprehensive</field>
            <field name="res_model">learning_japanese.comprehensive</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Create new comprehensive content
               </p>
            </field>
        </record>

        <record id="view_comprehensive_search" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.search</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <search string="Comprehensive Search">
                    <field name="title" string="Title" filter_domain="[('title', 'ilike', self)]"/>
                    <field name="description" string="Description" filter_domain="[('description', 'ilike', self)]"/>
                    <field name="content_only_kanji" string="Content" filter_domain="['|', ('content_only_kanji', 'ilike', self), ('content', 'ilike', self)]"/>
                    <searchpanel>
                        <field name="level" string="Level" icon="fa-signal" select="multi" enable_counters="1"/>
                        <field name="category_ids" string="Category" icon="fa-tags" select="multi" enable_counters="1"/>
                        <field name="book_ids" string="Book" icon="fa-book" select="multi" enable_counters="1"/>
                    </searchpanel>
                </search>
             </field>
        </record>

        <record id="view_comprehensive_list" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.list</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <list export_xlsx="1" multi_edit="1" string="Comprehensive List View">
                    <field name="title" optional="show"/>
                    <field name="description" optional="hide"/>
                    <field name="content_only_kanji" optional="show"/>
                    <field name="content" optional="hide"/>
                    <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="book_ids" widget="many2many_tags" optional="hide"/>
                    <field name="lesson_ids" widget="many2many_tags" optional="hide"/>
                    <field name="level" optional="hide"/>
                    <field name="deadline" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_comprehensive_form" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.form</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <form string="Comprehensive Form View">
                    <header>
                        <button name="action_reverse" string="Reverse" type="object" invisible="is_finalized == False"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="title"/>
                            <h1><field name="title" default_focus="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_grammar" invisible="1"/>
                                <field name="is_writing_or_speaking" invisible="1"/>

                                <field name="description" invisible="not is_grammar"/>
                            </group>
                        </group>
                        <br/>
                        <group>
                            <group>
                                <field name="lesson_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="book_ids" widget="many2many_tags" options="{'no_create': True}"/>

                                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': False}"/>
                            </group>
                            <group>
                                <field name="level"/>
                                <field name="deadline" invisible="not is_writing_or_speaking"/>
                                <field name="audio_file" widget="audio_player"/>
                            </group>
                        </group>

                       <notebook>
                            <page string="Nội dung">
                                <field class="html_field_font_size" name="content_only_kanji"/>
                            </page>

                             <page string="Chú thích Kanji">
                                <field class="html_field_font_size" name="content"/>
                            </page>
                       </notebook>

                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>