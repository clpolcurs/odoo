<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="comprehensive_action" model="ir.actions.act_window">
            <field name="name">Tổng hợp</field>
            <field name="res_model">learning_japanese.comprehensive</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Tạo mới nghe hiểu
               </p>
            </field>
        </record>

        <record id="view_comprehensive_search" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.search</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <search string="Comprehensive Search">
                    <field name="title" string="Title" filter_domain="[('title', 'ilike', self)]"/>
                    <field name="description" string="Diễn giải" filter_domain="[('description', 'ilike', self)]"/>
                    <field name="content_only_kanji" string="Nội dung" filter_domain="['|', ('content_only_kanji', 'ilike', self), ('content', 'ilike', self)]"/>
                </search>
             </field>
        </record>

        <record id="view_comprehensive_list" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.list</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <list export_xlsx="1" multi_edit="1" string="Listening List View">
                    <field name="title" optional="show"/>
                    <field name="description" optional="hide"/>
                    <field name="content_only_kanji" optional="show"/>
                    <field name="content" optional="hide"/>
                    <field name="category" optional="hide"/>
                    <field name="book_ids" widget="many2many_tags" optional="hide"/>
                    <field name="lesson_ids" widget="many2many_tags" optional="hide"/>
                    <field name="level" optional="hide"/>
                    <field name="deadline" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_comprehensive_form" model="ir.ui.view">
            <field name="name">learning_japanese.comprehensive.form</field>
            <field name="model">learning_japanese.comprehensive</field>
            <field name="arch" type="xml">
                <form string="Listening Form View">
                    <header>
                        <button name="action_reverse" string="Reverse" type="object" invisible="is_finalized == False"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="title"/>
                            <h1><field name="title" default_focus="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="description" invisible="category != 'grammar'"/>
                            </group>
                        </group>
                        <br/>
                        <group>
                            <group>
                                <field name="lesson_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="book_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="category"/>

                            </group>
                            <group>
                                <field name="level"/>
<!--                                <field name="is_finalized" invisible="1"/>-->
                                <field name="deadline" invisible="category not in ['writing', 'speaking']"/>
                                <field name="audio_file" widget="audio_player"/>
                            </group>
                        </group>

                       <notebook>
                            <page string="Nội dung">
                                <field class="html_field_font_size" name="content_only_kanji"/>
                            </page>

                             <page string="Chú thích Kanji">
                                <field class="html_field_font_size" name="content"/>
                            </page>
                       </notebook>

                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>