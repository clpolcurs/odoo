<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="context_tag_action" model="ir.actions.act_window">
            <field name="name">Topic</field>
            <field name="res_model">learning_japanese.context_tag</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                   Add a new topic or context tag to categorize vocabulary and grammar points. You can create a hierarchy of tags by setting parent tags, allowing for flexible organization of your learning materials.
               </p>
            </field>
        </record>

        <record id="view_context_tag_list" model="ir.ui.view">
            <field name="name">learning_japanese.context_tag.list</field>
            <field name="model">learning_japanese.context_tag</field>
            <field name="arch" type="xml">
                <list multi_edit="1" export_xlsx="1" string="Context Tag List View">
                    <field name="complete_name"/>
                </list>
            </field>
        </record>

        <record id="view_context_tag_form" model="ir.ui.view">
            <field name="name">learning_japanese.context_tag.form</field>
            <field name="model">learning_japanese.context_tag</field>
            <field name="arch" type="xml">
                <form string="Context Tag Form View">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Tag Name"/>
                            <h1><field name="name" default_focus="1"/></h1>
                            <field name="complete_name" readonly="1" invisible="not parent_id"/>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id" context="{'show_complete_name': True}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Từ vựng">
                                <list>
                                    <field name="vocabulary_ids"/>
                                </list>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>