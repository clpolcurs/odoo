<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">
        <!-- 1. Define a Category (Optional, for better UI organization) -->
        <record id="learning_japanese" model="ir.module.category">
            <field name="name">Learning Japanese</field>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Define the User Group -->
        <record id="learning_japanese_view_only_group" model="res.groups">
            <field name="name">Learning Japanese Read Only</field>
            <!-- Implied groups: Inherits rights of the standard internal user group -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 3. Define the Manager Group -->
        <record id="learning_japanese_admin" model="res.groups">
            <field name="name">Learning Japanese Admin</field>
            <!-- Implied groups: Inherits everything from the 'Custom User' group -->
            <field name="implied_ids" eval="[(4, ref('learning_japanese_view_only_group'))]"/>
<!--            &lt;!&ndash; Specific users can be added directly via XML (Optional) &ndash;&gt;-->
<!--            <field name="administrator" eval="[(4, ref('base.user_root'))]"/>-->
        </record>
    </data>
</odoo>